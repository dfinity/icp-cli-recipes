{{! Deploy static assets to the dfinity/certified-assets canister. }}
{{! `dir: string` Required. The single directory of built assets to synchronize. }}
{{! `build: [string]` Optional. Commands run before sync to produce the asset directory. }}
{{! `metadata: [{name, value}]` Optional. Pairs injected into the canister wasm via ic-wasm. }}

build:
  steps:
    {{#if metadata}}
    - type: script
      commands:
        - sh -c 'command -v ic-wasm >/dev/null 2>&1 || { echo >&2 "ic-wasm not found. See https://github.com/dfinity/ic-wasm"; exit 1; }'
    {{/if}}
    {{#if build}}
    - type: script
      commands:
        {{#each build}}
        - {{ this }}
        {{/each}}
    {{/if}}
    - type: pre-built
      url: https://github.com/dfinity/certified-assets/releases/download/v0.1.0/canister-release.wasm.gz
      sha256: b93463906d83c842601e9ec1ccb71bd20c0b67936f643eaad634d29dabba7628
    {{#if metadata}}
    - type: script
      commands:
        {{#each metadata}}
        - sh -c 'ic-wasm "$ICP_WASM_OUTPUT_PATH" -o "$ICP_WASM_OUTPUT_PATH" metadata "{{ name }}" -d "{{ value }}" --keep-name-section'
        {{/each}}
    {{/if}}

sync:
  steps:
    - type: plugin
      url: https://github.com/dfinity/certified-assets/releases/download/v0.1.0/plugin-release.wasm
      sha256: 03180c4cfd0db60894b38d76bc65b0bf217fcac8af8d240531d7f50a8776570f
      dirs:
        - {{ dir }}
